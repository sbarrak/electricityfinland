# Login: the first login is admin / admin and you must then choose your own username and password.
# Forgot it? Set RESET_ADMIN=1, restart once (login is admin / admin again), then remove it.
RESET_ADMIN=
# Optional: cookie signing key (a random one is generated and stored if empty)
SECRET_KEY=
# Host port nginx listens on in Docker (point your reverse proxy here)
WEB_PORT=8088

# Optional: Fingrid Open Data API key (free, https://data.fingrid.fi) for official wind forecast + actuals
FINGRID_API_KEY=

# Email server: set it in the web page (Email server menu). These are only defaults for an empty field.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_VERIFY=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
