# Login: the first login is admin / admin and you must then choose your own username and password.
# Forgot it? Set RESET_ADMIN=1, restart once (login is admin / admin again), then remove it.
RESET_ADMIN=
# Optional: cookie signing key (a random one is generated and stored if empty)
SECRET_KEY=
# Host port nginx listens on in Docker (point your reverse proxy here)
WEB_PORT=8088

# Optional: Fingrid Open Data API key (free, https://data.fingrid.fi) for official wind forecast + actuals
FINGRID_API_KEY=

# Email server: set it in the web page (Email server menu). These are only defaults for an empty field.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_VERIFY=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Visitor statistics and search engines (all optional, empty = off). See README "Visitor statistics and Google Search".
# Google Analytics 4: the Measurement ID of your web data stream (G-XXXXXXXXXX)
GA_MEASUREMENT_ID=
# Google Search Console, "HTML file" verification: the file name Google gives you (google1234abcd.html)
GOOGLE_SITE_VERIFICATION=
# Matomo (self-hosted or Matomo Cloud): the address of your Matomo and the site ID, e.g. https://matomo.example.com/ and 1
MATOMO_URL=
MATOMO_SITE_ID=
# Matomo without cookies needs no consent (default). true = Matomo sets cookies (asked for like Google Analytics)
MATOMO_COOKIES=false
# Ask visitors before Google Analytics (or Matomo with cookies) sets cookies (GDPR). Set false only if you have another consent solution.
ANALYTICS_CONSENT=true
# The public address for sitemap.xml / robots.txt, e.g. https://power.example.com (empty = taken from the request)
SITE_URL=
# false = robots.txt asks search engines not to index the site
SEARCH_INDEXING=true
