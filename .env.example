# Required: login password and cookie signing key (any long random string)
APP_PASSWORD=change-me
SECRET_KEY=replace-with-long-random-string
# Host port nginx listens on (point your reverse proxy here)
WEB_PORT=8088

# Optional: Fingrid Open Data API key (free, https://data.fingrid.fi) for official wind forecast + actuals
FINGRID_API_KEY=

# Optional: SMTP for email alerts (e.g. Synology MailPlus / Mail Server)
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
# set false if your NAS mail server uses a self-signed certificate
SMTP_VERIFY=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
